{
  "AuthService": {
    "Issuer": "AuthService",
    "Audience": "sample-product-api",
    "JwksUrl": "https://auth.example.com/.well-known/jwks.json",
    "Entitlements": {
      "WebhookSecrets": [ "replace-with-the-webhook-signing-secret" ]
    }
  },
  "Logging": {
    "LogLevel": {
      "Default": "Information",
      "Microsoft.AspNetCore": "Warning"
    }
  }
}
