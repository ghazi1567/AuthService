<?xml version="1.0" encoding="utf-8"?>
<configuration>
  <packageSources>
    <clear />
    <add key="nuget.org" value="https://api.nuget.org/v3/index.json" />
    <!-- Where a locally packed or CI-packed AuthService.Authorization lands. A release adds the GitHub Packages feed under the key
         "github" (see docs/decisions/0009-publish-the-authorization-package-to-github-packages.md). -->
    <add key="authservice-local" value="../artifacts/packages" />
  </packageSources>
  <!-- With central package management, more than one remote source needs a mapping (NU1507, an error here). The product's own package
       comes only from the local folder or the GitHub Packages feed a release checks, never from nuget.org, so a release verifies the
       package it just pushed and not a copy that may already be public; everything else comes from nuget.org. A source named here that
       is not configured (the "github" feed, outside a release) is ignored. -->
  <packageSourceMapping>
    <packageSource key="nuget.org">
      <package pattern="*" />
    </packageSource>
    <packageSource key="authservice-local">
      <package pattern="AuthService.Authorization" />
    </packageSource>
    <packageSource key="github">
      <package pattern="AuthService.Authorization" />
    </packageSource>
  </packageSourceMapping>
</configuration>
