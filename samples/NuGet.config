<?xml version="1.0" encoding="utf-8"?>
<configuration>
  <packageSources>
    <clear />
    <add key="nuget.org" value="https://api.nuget.org/v3/index.json" />
    <!-- Where a locally packed or CI-packed AuthService.Authorization lands. A release adds the GitHub Packages feed (see
         docs/decisions/0009-publish-the-authorization-package-to-github-packages.md). -->
    <add key="authservice-local" value="../artifacts/packages" />
  </packageSources>
</configuration>
