# Copy to deploy/.env and fill in. deploy/.env is ignored by git: never commit it.

# ---- Which version ----------------------------------------------------------------------------------------------------------
# The release to run, as published on the repository's Releases page without the leading v (a tag v1.0.0 is 1.0.0). Pin an exact version
# so an update is something you do on purpose. To go back, put the previous version here and run: docker compose pull && docker compose up -d
AUTHSERVICE_VERSION=

# Where the images are. Only change this if you publish them somewhere else.
# AUTHSERVICE_REGISTRY=ghcr.io/ghazi1567

# ---- Your names -------------------------------------------------------------------------------------------------------------
# Two names that already point at this server (an A record each; if you use Cloudflare, "DNS only" / grey cloud). The proxy gets a
# certificate for each. AUTH_HOST is the API (products fetch the public keys from https://<AUTH_HOST>/.well-known/jwks.json); APP_HOST is
# the web console people sign in on, and where the links in emails point.
AUTH_HOST=auth.example.com
APP_HOST=app.example.com

# Let's Encrypt writes to this address if a certificate is about to expire and cannot be renewed.
ACME_EMAIL=

# ---- Secrets ----------------------------------------------------------------------------------------------------------------
# PostgreSQL password for the bundled database. Make it long and random: openssl rand -base64 24
POSTGRES_PASSWORD=change-me

# 32 random bytes, base64: openssl rand -base64 32
# Encrypts the signing keys in the database. Losing it means losing every stored signing key: back it up somewhere that is not this
# server and not the database backups.
AUTH_KEY_ENCRYPTION_KEY=

# ---- Tokens -----------------------------------------------------------------------------------------------------------------
# The iss claim of issued tokens. Products must be configured with the same value.
AUTH_ISSUER=AuthService

# ---- Email ------------------------------------------------------------------------------------------------------------------
# Email: Brevo, or File to write emails to disk instead (for a trial run only).
EMAIL_PROVIDER=Brevo
BREVO_API_KEY=
# An address on a domain you have authenticated in Brevo (SPF, DKIM, DMARC), never a personal mailbox: see docs/deployment.md, "Production email".
EMAIL_FROM_ADDRESS=
EMAIL_FROM_NAME=Auth Service

# ---- Optional ---------------------------------------------------------------------------------------------------------------
# The private network the stack uses. Change it only if it clashes with a network your server already uses.
# DOCKER_SUBNET=172.29.200.0/24

# A network allowed to read /metrics besides this machine, in CIDR form (for example 10.0.0.0/8), so a monitoring server can scrape it.
# The proxy never passes /metrics on to the internet, so this only matters for a scraper inside the stack's own network.
METRICS_ALLOWED_NETWORK=
