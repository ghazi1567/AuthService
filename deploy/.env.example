# Copy to deploy/.env and fill in. deploy/.env is ignored by git: never commit it.

# PostgreSQL password for the bundled database.
POSTGRES_PASSWORD=change-me

# 32 random bytes, base64: openssl rand -base64 32
# Encrypts the signing keys in the database. Losing it means losing every stored signing key: back it up.
AUTH_KEY_ENCRYPTION_KEY=

# The iss claim of issued tokens. Products must be configured with the same value.
AUTH_ISSUER=AuthService

# Email: Brevo, or File to write emails to disk instead (for a trial run only).
EMAIL_PROVIDER=Brevo
BREVO_API_KEY=
# An address on a domain you have authenticated in Brevo (SPF, DKIM, DMARC), never a personal mailbox: see docs/deployment.md, "Production email".
EMAIL_FROM_ADDRESS=
EMAIL_FROM_NAME=Auth Service

# Where the links in emails point: the front-end that handles /verify-email, /reset-password and /accept-invitation.
PUBLIC_BASE_URL=https://app.example.com

# The reverse proxy in front of the API (its IP address), so rate limits and audit entries see real client addresses.
# Leave empty if nothing sits in front.
TRUSTED_PROXY=

# A network allowed to read /metrics besides loopback, in CIDR form (for example 10.0.0.0/8), so a monitoring server can scrape it.
# Leave empty to allow loopback only.
METRICS_ALLOWED_NETWORK=
