@using AuthService.Web.Api
@* What a new password must be, ticked off as the person types. app.js updates the rows as the password field changes; without it the
   list simply states the rule. Met or not is shown by the icon and a word, never by colour alone. *@
<ul class="rules" id="@Id" data-rules-for="@ForField">
    <li class="rule" data-min-length="@PasswordPolicy.MinLength">
        <span class="rule-icon" data-state="unmet"><Icon Name="circle" /></span>
        <span class="rule-icon" data-state="met" hidden><Icon Name="check-circle" /></span>
        <span>At least @PasswordPolicy.MinLength characters</span>
        <span class="visually-hidden" data-status>(not met yet)</span>
    </li>
</ul>

@code {
    [Parameter, EditorRequired] public string Id { get; set; } = "";

    /// <summary>The id of the password input these rules are about.</summary>
    [Parameter, EditorRequired] public string ForField { get; set; } = "";
}
