@page "/forgot-password"
@layout AuthLayout
@using System.ComponentModel.DataAnnotations
@using AuthService.Web.Api
@inject AuthApiClient Api

<PageTitle>@(sent ? "Check your email" : "Reset your password") · Auth Service</PageTitle>

@if (sent)
{
    <div class="auth-sent">
        <div class="icon-tile"><Icon Name="mail" /></div>
        <h1 class="auth-title">Check your email</h1>
        <p class="auth-lead">If an account exists for @sentTo, we've sent a link to reset your password. The link works for 1 hour.</p>

        @switch (again)
        {
            case Problem.Again:
                <AlertBanner Kind="AlertKind.Success" Title="We've sent it again" Class="auth-alert">
                    <p class="alert-body">Check your inbox and your spam folder.</p>
                </AlertBanner>
                break;
            case Problem.RateLimited:
                <AlertBanner Kind="AlertKind.Warning" Title="Too many requests" Class="auth-alert">
                    <p class="alert-body">@WaitText</p>
                </AlertBanner>
                break;
            case Problem.Unavailable:
                <AlertBanner Kind="AlertKind.Error" Title="We couldn't send it again" Class="auth-alert">
                    <p class="alert-body">Auth Service isn't responding right now. Try again in a moment.</p>
                </AlertBanner>
                break;
        }

        <form method="post" @onsubmit="AgainAsync" @formname="again" class="auth-actions">
            <AntiforgeryToken />
            <input type="hidden" name="email" value="@sentTo" />
            <button type="submit" class="btn btn-secondary btn-lg btn-block"
                    data-busy-label="Sending…"
                    data-countdown="@(again == Problem.RateLimited && waitSeconds is > 0 ? waitSeconds : 60)"
                    data-countdown-label="Resend in {0}s"
                    data-countdown-done="Resend email"
                    data-countdown-announce="forgot-announce"
                    data-countdown-message="You can send the email again now.">Resend email</button>
            <div id="forgot-announce" class="visually-hidden" aria-live="polite"></div>
        </form>

        <p class="auth-alt"><a href="/login">Back to sign in</a></p>
    </div>
}
else
{
    <h1 class="auth-title">Reset your password</h1>
    <p class="auth-lead">Enter your email and we'll send you a link to choose a new one.</p>

    @switch (problem)
    {
        case Problem.RateLimited:
            <AlertBanner Kind="AlertKind.Warning" Title="Too many attempts" Class="auth-alert">
                <p class="alert-body">@WaitText</p>
            </AlertBanner>
            break;
        case Problem.Unavailable:
            <AlertBanner Kind="AlertKind.Error" Title="We couldn't send the link" Class="auth-alert">
                <p class="alert-body">Auth Service isn't responding right now. Your details are safe. Try again in a moment.</p>
            </AlertBanner>
            break;
    }

    <EditForm Model="Model" FormName="forgot" method="post" OnValidSubmit="SendAsync" novalidate class="auth-form">
        <DataAnnotationsValidator />
        <TextField Id="forgot-email"
                   Label="Email"
                   Type="email"
                   Autocomplete="username"
                   @bind-Value="Model.Email"
                   Error="@context.GetValidationMessages(context.Field(nameof(ForgotInput.Email))).FirstOrDefault()" />
        <div class="auth-actions">
            @if (problem == Problem.RateLimited && waitSeconds is > 0)
            {
                <button type="submit" class="btn btn-primary btn-lg btn-block"
                        data-busy-label="Sending…"
                        data-countdown="@waitSeconds"
                        data-countdown-label="Try again in {0}s"
                        data-countdown-done="Send reset link"
                        data-countdown-announce="forgot-announce-form"
                        data-countdown-message="You can try again now.">Send reset link</button>
                <div id="forgot-announce-form" class="visually-hidden" aria-live="polite"></div>
            }
            else
            {
                <button type="submit" class="btn btn-primary btn-lg btn-block" data-busy-label="Sending…">Send reset link</button>
            }
        </div>
    </EditForm>

    <p class="auth-alt"><a href="/login">Back to sign in</a></p>
}

@code {
    private bool sent;
    private string sentTo = "";
    private int? waitSeconds;
    private Problem problem = Problem.None;
    private Problem again = Problem.None;

    [CascadingParameter] private HttpContext? HttpContext { get; set; }

    [SupplyParameterFromForm(FormName = "forgot", Name = "Model")] private ForgotInput? Posted { get; set; }

    [SupplyParameterFromForm(FormName = "again", Name = "email")] private string? AgainEmail { get; set; }

    private ForgotInput Model => Posted ??= new();

    private CancellationToken Cancellation => HttpContext?.RequestAborted ?? CancellationToken.None;

    private string WaitText => waitSeconds is { } seconds ? $"Wait {seconds} seconds, then try again." : "Wait a moment, then try again.";

    protected override void OnInitialized()
    {
        // The resend form only exists once the link was sent, and a posted form must be on the page when the post arrives.
        if (!string.IsNullOrWhiteSpace(AgainEmail))
        {
            sentTo = AgainEmail.Trim();
            sent = true;
        }
    }

    private async Task SendAsync()
    {
        var email = Model.Email!.Trim();
        var result = await Api.PostNoContentAsync("/api/auth/password/forgot", new ForgotPasswordRequest(email), Cancellation);
        if (result.IsSuccess)
        {
            // The same screen for every address: the page never says whether an account exists.
            sentTo = email;
            sent = true;
            return;
        }

        problem = result.Problem!.Code == "rate_limited" ? Problem.RateLimited : Problem.Unavailable;
        waitSeconds = WaitFor(result.Problem);
    }

    private async Task AgainAsync()
    {
        var result = await Api.PostNoContentAsync("/api/auth/password/forgot", new ForgotPasswordRequest(sentTo), Cancellation);
        if (result.IsSuccess)
        {
            again = Problem.Again;
            return;
        }

        again = result.Problem!.Code == "rate_limited" ? Problem.RateLimited : Problem.Unavailable;
        waitSeconds = WaitFor(result.Problem);
    }

    private static int? WaitFor(ApiProblem apiProblem) =>
        apiProblem.Code == "rate_limited" && apiProblem.RetryAfter is { } retryAfter
            ? Math.Max(1, (int)Math.Ceiling(retryAfter.TotalSeconds))
            : null;

    private enum Problem
    {
        None,
        Again,
        RateLimited,
        Unavailable,
    }

    public sealed class ForgotInput
    {
        [Required(ErrorMessage = "Enter your email address.")]
        [EmailAddress(ErrorMessage = "Enter a valid email address, like anna@acme.com.")]
        public string? Email { get; set; }
    }
}
