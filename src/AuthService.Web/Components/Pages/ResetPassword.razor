@page "/reset-password"
@layout AuthLayout
@using System.ComponentModel.DataAnnotations
@using AuthService.Web.Api
@inject AuthApiClient Api
@inject NavigationManager Navigation

<PageTitle>@Title · Auth Service</PageTitle>

@switch (view)
{
    case View.Done:
        <div class="auth-sent">
            <div class="icon-tile is-success"><Icon Name="check-circle" /></div>
            <h1 class="auth-title">Your password is changed</h1>
            <p class="auth-lead">For your security, you've been signed out everywhere else. Sign in with your new password.</p>
            <div class="auth-actions">
                <a class="btn btn-primary btn-lg btn-block" href="/login">Continue to sign in</a>
            </div>
        </div>
        break;

    case View.Form:
        <h1 class="auth-title">Choose a new password</h1>
        <p class="auth-lead">You'll be signed out on your other devices.</p>

        @switch (problem)
        {
            case Problem.RateLimited:
                <AlertBanner Kind="AlertKind.Warning" Title="Too many attempts" Class="auth-alert">
                    <p class="alert-body">@(waitSeconds is { } seconds ? $"Wait {seconds} seconds, then try again." : "Wait a moment, then try again.")</p>
                </AlertBanner>
                break;
            case Problem.Unavailable:
                <AlertBanner Kind="AlertKind.Error" Title="We couldn't change your password" Class="auth-alert">
                    <p class="alert-body">Auth Service isn't responding right now. Your link is still good. Try again in a moment.</p>
                </AlertBanner>
                break;
        }

        @* The link's token lives only in this form: app.js takes it out of the address bar and the history entry as the page loads,
           and the form posts to a clean address. *@
        <EditForm Model="Model" FormName="reset" method="post" action="/reset-password" OnValidSubmit="ResetAsync" novalidate class="auth-form" data-link-form="clean">
            <DataAnnotationsValidator />
            <input type="hidden" name="token" value="@token" />

            @{
                var messages = context.GetValidationMessages().ToList();
            }
            @if (messages.Count > 0)
            {
                <AlertBanner Kind="AlertKind.Error" Title="@(messages.Count == 1 ? "Fix 1 problem to change your password" : $"Fix {messages.Count} problems to change your password")">
                    <ul>
                        @foreach (var (field, id) in Fields)
                        {
                            @if (context.GetValidationMessages(context.Field(field)).FirstOrDefault() is { } message)
                            {
                                <li><a href="#@id">@message</a></li>
                            }
                        }
                    </ul>
                </AlertBanner>
            }

            <PasswordField Id="reset-password"
                           Label="New password"
                           Autocomplete="new-password"
                           @bind-Value="Model.NewPassword"
                           Error="@context.GetValidationMessages(context.Field(nameof(ResetInput.NewPassword))).FirstOrDefault()"
                           BelowId="reset-rules">
                <Below><PasswordRules Id="reset-rules" ForField="reset-password" /></Below>
            </PasswordField>

            <PasswordField Id="reset-confirm"
                           Label="Confirm new password"
                           Autocomplete="new-password"
                           @bind-Value="Model.Confirm"
                           Error="@context.GetValidationMessages(context.Field(nameof(ResetInput.Confirm))).FirstOrDefault()" />

            <div class="auth-actions">
                @if (problem == Problem.RateLimited && waitSeconds is > 0)
                {
                    <button type="submit" class="btn btn-primary btn-lg btn-block"
                            data-busy-label="Changing password…"
                            data-countdown="@waitSeconds"
                            data-countdown-label="Try again in {0}s"
                            data-countdown-done="Change password"
                            data-countdown-announce="reset-announce"
                            data-countdown-message="You can try again now.">Change password</button>
                    <div id="reset-announce" class="visually-hidden" aria-live="polite"></div>
                }
                else
                {
                    <button type="submit" class="btn btn-primary btn-lg btn-block" data-busy-label="Changing password…">Change password</button>
                }
            </div>
        </EditForm>
        break;

    default:
        <div class="auth-sent">
            <div class="icon-tile is-warning"><Icon Name="alert-triangle" /></div>
            <h1 class="auth-title">This link can't be used</h1>
            <p class="auth-lead">It has expired or was already used. Ask for a new one and we'll email it to you.</p>
            <div class="auth-actions">
                <a class="btn btn-primary btn-lg btn-block" href="/forgot-password">Send a new link</a>
            </div>
            <p class="auth-alt"><a href="/login">Back to sign in</a></p>
        </div>
        break;
}

@code {
    private static readonly (string Field, string Id)[] Fields =
    [
        (nameof(ResetInput.NewPassword), "reset-password"),
        (nameof(ResetInput.Confirm), "reset-confirm"),
    ];

    private View view = View.Invalid;
    private Problem problem = Problem.None;
    private int? waitSeconds;
    private string token = "";

    [CascadingParameter] private HttpContext? HttpContext { get; set; }

    /// <summary>The link from the email. It is only ever read here, then taken out of the address bar by app.js.</summary>
    [SupplyParameterFromQuery(Name = "token")] private string? QueryToken { get; set; }

    /// <summary>"done" or "invalid" after the link was used (these say nothing secret).</summary>
    [SupplyParameterFromQuery(Name = "result")] private string? Result { get; set; }

    [SupplyParameterFromForm(FormName = "reset", Name = "token")] private string? PostedToken { get; set; }

    [SupplyParameterFromForm(FormName = "reset", Name = "Model")] private ResetInput? Posted { get; set; }

    private ResetInput Model => Posted ??= new();

    private string Title => view switch
    {
        View.Done => "Password changed",
        View.Form => "Choose a new password",
        _ => "Link can't be used",
    };

    private CancellationToken Cancellation => HttpContext?.RequestAborted ?? CancellationToken.None;

    protected override void OnInitialized()
    {
        // A posted form must already be on the page when the post arrives, so the view that holds it is chosen first.
        if (!string.IsNullOrEmpty(PostedToken))
        {
            token = PostedToken;
            view = View.Form;
        }
        else if (!string.IsNullOrEmpty(QueryToken))
        {
            token = QueryToken;
            view = View.Form;
        }
        else if (Result == "done")
        {
            view = View.Done;
        }
    }

    private async Task ResetAsync(EditContext context)
    {
        var result = await Api.PostNoContentAsync("/api/auth/password/reset", new ResetPasswordRequest(token, Model.NewPassword!), Cancellation);

        // Never carry a password back into the page.
        Model.NewPassword = null;
        Model.Confirm = null;

        if (result.IsSuccess)
        {
            Navigation.NavigateTo("/reset-password?result=done");
            return;
        }

        var apiProblem = result.Problem!;
        if (apiProblem.Code == "reset_link_invalid")
        {
            Navigation.NavigateTo("/reset-password?result=invalid");
            return;
        }

        if (apiProblem.Status == StatusCodes.Status400BadRequest && apiProblem.Errors is { Count: > 0 } errors
            && errors.TryGetValue("NewPassword", out var reasons) && reasons.Length > 0)
        {
            // The API checks the password before it touches the link, so the link is still good: show why, beside the field.
            new ValidationMessageStore(context).Add(context.Field(nameof(ResetInput.NewPassword)), reasons[0]);
            context.NotifyValidationStateChanged();
            return;
        }

        problem = apiProblem.Code == "rate_limited" ? Problem.RateLimited : Problem.Unavailable;
        waitSeconds = problem == Problem.RateLimited && apiProblem.RetryAfter is { } retryAfter
            ? Math.Max(1, (int)Math.Ceiling(retryAfter.TotalSeconds))
            : null;
    }

    private enum View
    {
        Invalid,
        Form,
        Done,
    }

    private enum Problem
    {
        None,
        RateLimited,
        Unavailable,
    }

    public sealed class ResetInput
    {
        [Required(ErrorMessage = "Choose a new password.")]
        [StringLength(PasswordPolicy.MaxLength, MinimumLength = PasswordPolicy.MinLength,
            ErrorMessage = "Use between 8 and 128 characters.")]
        public string? NewPassword { get; set; }

        [Required(ErrorMessage = "Type the new password again.")]
        [Compare(nameof(NewPassword), ErrorMessage = "The two passwords don't match.")]
        public string? Confirm { get; set; }
    }
}
