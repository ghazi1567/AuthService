@page "/platform/products"
@attribute [Authorize]
@layout PlatformLayout
@using System.Globalization
@using AuthService.Web.Api
@inject AuthApiClient Api
@inject PlatformSession Platform
@inject OneTimeSecrets Secrets
@inject TimeProvider Time
@inject NavigationManager Navigation

<PageTitle>Products · Auth Service</PageTitle>

@if (leaving || !ready)
{
    @* Being sent on, or still loading: Blazor renders once before the page has its data. *@
}
else if (loadFailed)
{
    <h1 class="page-title">Products</h1>
    <ErrorState Title="We couldn't load the products" RetryHref="/platform/products" Reference="@reference" />
}
else
{
    <div class="page-head">
        <div>
            <h1 class="page-title">Products</h1>
            <p class="page-lead">Every product on the platform, available or not. A product becomes available once it has permissions; organisations can only subscribe to, and people only open, an available product.</p>
        </div>
        <a class="btn btn-primary" href="/platform/products?register=1"><Icon Name="plus" />Register a product</a>
    </div>

    @if (Notice() is { } notice)
    {
        @notice
    }

    @if (products.Count == 0)
    {
        <EmptyState Title="No products yet" IconName="building">
            <p class="empty-body">Register a product to give it a client secret, a permission list and a place to be opened from.</p>
            <a class="btn btn-primary" href="/platform/products?register=1">Register a product</a>
        </EmptyState>
    }
    else
    {
        <div class="table-wrap">
            <table class="data-table">
                <thead>
                    <tr>
                        <th scope="col">Product</th>
                        <th scope="col">Status</th>
                        <th scope="col">Permissions</th>
                        <th scope="col">Opens at</th>
                        <th scope="col"><span class="visually-hidden">Actions</span></th>
                    </tr>
                </thead>
                <tbody>
                    @foreach (var product in products)
                    {
                        <tr>
                            <td data-label="Product">
                                <span class="person-name">@product.Name</span>
                                <code class="mono audit-detail">@product.Key</code>
                            </td>
                            <td data-label="Status" class="status-cell">
                                @if (product.IsActive)
                                {
                                    <StatusBadge Kind="success" IconName="check" Label="Available" />
                                    <span class="status-note">Organisations can subscribe and people can open it.</span>
                                }
                                else
                                {
                                    <StatusBadge Kind="neutral" IconName="slash" Label="Not available" />
                                    <span class="status-note">@(product.PermissionCount == 0 ? "Add at least one permission, then make it available." : "Nobody can open it and organisations can't subscribe. Make it available when it is ready.")</span>
                                }
                            </td>
                            <td data-label="Permissions">@product.PermissionCount @(product.PermissionCount == 1 ? "permission" : "permissions")</td>
                            <td data-label="Opens at">
                                @if (product.LaunchUrl is { } address)
                                {
                                    <code class="mono audit-detail">@address</code>
                                }
                                else
                                {
                                    <span class="muted">Not set. People can't open it from the picker.</span>
                                }
                            </td>
                            <td data-label="Actions" class="row-actions">
                                @if (product.IsActive)
                                {
                                    <a class="btn btn-primary btn-sm" href="/platform/products?testorg=@product.Id">Test organisation</a>
                                    <a class="btn btn-secondary btn-sm" href="/platform/products?subscribe=@product.Id">Subscribe organisation</a>
                                    <a class="btn btn-secondary btn-sm" href="/platform/products?withdraw=@product.Id">Withdraw</a>
                                }
                                else if (product.PermissionCount > 0)
                                {
                                    <form method="post" action="/platform/products/@product.Id/active" class="inline-form-row">
                                        <AntiforgeryToken />
                                        <input type="hidden" name="isActive" value="true" />
                                        <button type="submit" class="btn btn-primary btn-sm" data-busy-label="Making available…">Make available</button>
                                    </form>
                                }

                                <a class="btn btn-secondary btn-sm" href="/platform/products/@product.Id/permissions">Permissions</a>
                                <a class="btn btn-secondary btn-sm" href="/platform/products?rename=@product.Id">Rename</a>
                                <a class="btn btn-secondary btn-sm" href="/platform/products?launch=@product.Id">Opens at</a>
                                <a class="btn btn-secondary btn-sm" href="/platform/products?rotate=@product.Id">Replace secret</a>
                            </td>
                        </tr>
                    }
                </tbody>
            </table>
        </div>
        <p class="table-foot">Showing @products.Count @(products.Count == 1 ? "product" : "products")</p>
    }

    @if (revealed is not null)
    {
        <div class="modal-backdrop">
            <div class="modal modal-wide" role="dialog" aria-modal="true" aria-labelledby="secret-title">
                <div class="modal-body">
                    <h2 id="secret-title" class="modal-title">@(Registered == "1" ? "Product registered" : "New client secret")</h2>
                    @if (Registered == "1")
                    {
                        <AlertBanner Kind="AlertKind.Success" Title="@(Live == "1" ? $"{RegisteredName} is registered and available" : $"{RegisteredName} is registered")" Class="dialog-alert">
                            @if (Live == "1")
                            {
                                <p class="alert-body">Organisations can subscribe to it and people with a seat can open it. Give its team the details below.</p>
                            }
                            else if (PermissionTotal > 0)
                            {
                                <p class="alert-body">It isn't available yet. Make it available when it is ready. Give its team the details below.</p>
                            }
                            else
                            {
                                <p class="alert-body">It isn't available yet. Next, give it its permissions, then make it available. Give its team the client id and the secret below.</p>
                            }
                        </AlertBanner>
                    }
                    else
                    {
                        <AlertBanner Kind="AlertKind.Info" Title="@OldSecretTitle" Class="dialog-alert">
                            <p class="alert-body">@OldSecretBody</p>
                        </AlertBanner>
                    }

                    <AlertBanner Kind="AlertKind.Warning" Title="You won't see this again" Class="dialog-alert">
                        <p class="alert-body">Copy the secret now and give it to the product's team. It is never shown again. If it is lost, replace the secret.</p>
                    </AlertBanner>
                    @if (Registered == "1" && !string.IsNullOrWhiteSpace(Audience))
                    {
                        <p class="modal-text">Token audience: <code class="mono">@Audience</code></p>
                    }
                    @if (!string.IsNullOrWhiteSpace(ClientId))
                    {
                        <p class="modal-text">Client id: <code class="mono">@ClientId</code></p>
                    }
                    @if (Registered == "1" && !string.IsNullOrWhiteSpace(OpensAt))
                    {
                        <p class="modal-text">Opens at: <code class="mono">@OpensAt</code></p>
                    }
                    @if (Registered == "1" && PermissionTotal > 0)
                    {
                        <p class="modal-text">Permissions: @PermissionTotal @(PermissionTotal == 1 ? "permission" : "permissions") registered</p>
                    }

                    <label class="visually-hidden" for="raw-secret">Client secret</label>
                    <input id="raw-secret" class="input mono secret-value" readonly value="@revealed" autocomplete="off" spellcheck="false" />
                    <p class="field-message" aria-live="polite" data-copy-status></p>
                    <button type="button" class="btn btn-secondary" data-needs-script hidden data-copy-from="raw-secret"><Icon Name="copy" />Copy secret</button>
                </div>
                <div class="modal-foot">
                    @if (Registered == "1" && PermissionTotal == 0 && AppId is { } registeredId)
                    {
                        <a class="btn btn-secondary" href="/platform/products/@registeredId/permissions">Add its permissions</a>
                    }

                    <a class="btn btn-primary" href="/platform/products">I've saved it</a>
                </div>
            </div>
        </div>
    }
    else if (registering)
    {
        <div class="modal-backdrop">
            <div class="modal modal-wide" role="dialog" aria-modal="true" aria-labelledby="register-title">
                <form method="post" @onsubmit="RegisterAsync" @formname="register" data-unsaved-guard>
                    <AntiforgeryToken />
                    <div class="modal-body">
                        <h2 id="register-title" class="modal-title">Register a product</h2>
                        <p class="modal-text">A product gets a client id and a client secret to prove who it is to Auth Service. The secret is shown once. Fill in everything here and it is ready in one step, or leave the optional parts for later.</p>
                        @if (errors.Count > 0)
                        {
                            <AlertBanner Kind="AlertKind.Error" Title="@(errors.Count == 1 ? "Fix 1 problem" : $"Fix {errors.Count} problems")" Class="dialog-alert">
                                <ul>
                                    @foreach (var error in errors)
                                    {
                                        <li>@error</li>
                                    }
                                </ul>
                            </AlertBanner>
                        }

                        <div class="field">
                            <label for="product-name">Name</label>
                            <input id="product-name" name="name" class="input" value="@enteredName" maxlength="200" autocomplete="off" />
                            <p class="field-message">What people see, like "Helpdesk".</p>
                        </div>
                        <div class="field">
                            <label for="product-key">Key</label>
                            <input id="product-key" name="key" class="input mono" value="@enteredKey" maxlength="63" autocomplete="off" spellcheck="false" />
                            <p class="field-message">Short and permanent: lowercase letters, digits and hyphens, like "helpdesk". It can't be changed later.</p>
                        </div>
                        <div class="field">
                            <label for="product-audience">Token audience</label>
                            <input id="product-audience" name="audience" class="input mono" value="@enteredAudience" maxlength="200" autocomplete="off" spellcheck="false" />
                            <p class="field-message">The value the product's tokens carry and check for, like "helpdesk-api". No two products can share one. Leave it empty to use the key plus -api. It can't be changed later.</p>
                        </div>
                        <div class="field">
                            <label for="product-launch">Where it opens (optional)</label>
                            <input id="product-launch" name="launchUrl" class="input mono" value="@enteredLaunchUrl" maxlength="2000" autocomplete="off" spellcheck="false" placeholder="https://helpdesk.example.com/api/session/launch" />
                            <p class="field-message">Where people are sent when they choose it in the picker: a full https address, or http for localhost while developing. You can set it later.</p>
                        </div>
                        <div class="field">
                            <label for="permissions-text">Permissions (optional)</label>
                            <textarea id="permissions-text" name="permissions" class="input mono permissions-text" rows="7" spellcheck="false" autocomplete="off" placeholder="ticket.reply | Answer tickets | Reply to a customer&#10;ticket.close | Close tickets">@enteredPermissions</textarea>
                            <p class="field-message">One per line as key | label | description, or paste the permission JSON the product's team keeps. Permissions can be added later, but never removed.</p>
                            <label class="btn btn-secondary btn-sm" data-needs-script hidden for="permissions-file"><Icon Name="plus" />Load from a file</label>
                            <input id="permissions-file" type="file" hidden accept=".json,.txt,application/json,text/plain" data-load-into="permissions-text" />
                        </div>
                        <label class="check">
                            <input type="checkbox" name="activate" checked="@activateChecked" />
                            <span>Make it available now</span>
                            <span class="muted">Organisations can then subscribe. Needs at least one permission.</span>
                        </label>
                    </div>
                    <div class="modal-foot">
                        <a class="btn btn-secondary" href="/platform/products">Cancel</a>
                        <button type="submit" class="btn btn-primary" data-busy-label="Registering…">Register product</button>
                    </div>
                </form>
            </div>
        </div>
    }
    else if (launching is { } toLaunch)
    {
        <div class="modal-backdrop">
            <div class="modal modal-wide" role="dialog" aria-modal="true" aria-labelledby="launch-title">
                <form method="post" @onsubmit="SaveLaunchAsync" @formname="launch" data-unsaved-guard>
                    <AntiforgeryToken />
                    <input type="hidden" name="id" value="@toLaunch.Id" />
                    <div class="modal-body">
                        <h2 id="launch-title" class="modal-title">Where '@toLaunch.Name' opens</h2>
                        <p class="modal-text">When someone chooses this product in the picker, they are sent to this address. Leave it empty to stop people opening it from there.</p>
                        @if (errors.Count > 0)
                        {
                            <AlertBanner Kind="AlertKind.Error" Title="@(errors.Count == 1 ? "Fix 1 problem" : $"Fix {errors.Count} problems")" Class="dialog-alert">
                                <ul>
                                    @foreach (var error in errors)
                                    {
                                        <li>@error</li>
                                    }
                                </ul>
                            </AlertBanner>
                        }

                        <div class="field">
                            <label for="launch-url">Address</label>
                            <input id="launch-url" name="url" class="input mono" value="@enteredUrl" maxlength="2000" autocomplete="off" spellcheck="false" placeholder="https://helpdesk.example.com/signed-in" />
                            <p class="field-message">A full https address. It can't contain a user name, a password or a # fragment.</p>
                        </div>
                    </div>
                    <div class="modal-foot">
                        <a class="btn btn-secondary" href="/platform/products">Cancel</a>
                        <button type="submit" class="btn btn-primary" data-busy-label="Saving…">Save address</button>
                    </div>
                </form>
            </div>
        </div>
    }
    else if (renaming is { } toRename)
    {
        <div class="modal-backdrop">
            <div class="modal" role="dialog" aria-modal="true" aria-labelledby="rename-title">
                <form method="post" @onsubmit="RenameAsync" @formname="rename" data-unsaved-guard>
                    <AntiforgeryToken />
                    <input type="hidden" name="id" value="@toRename.Id" />
                    <div class="modal-body">
                        <h2 id="rename-title" class="modal-title">Rename '@toRename.Name'</h2>
                        <p class="modal-text">This is the name people see. Its key, <code class="mono">@toRename.Key</code>, and its token audience stay as they are, so the product keeps working.</p>
                        @if (errors.Count > 0)
                        {
                            <AlertBanner Kind="AlertKind.Error" Title="@(errors.Count == 1 ? "Fix 1 problem" : $"Fix {errors.Count} problems")" Class="dialog-alert">
                                <ul>
                                    @foreach (var error in errors)
                                    {
                                        <li>@error</li>
                                    }
                                </ul>
                            </AlertBanner>
                        }

                        <div class="field">
                            <label for="rename-name">Name</label>
                            <input id="rename-name" name="name" class="input" value="@enteredNewName" maxlength="200" autocomplete="off" />
                        </div>
                    </div>
                    <div class="modal-foot">
                        <a class="btn btn-secondary" href="/platform/products">Cancel</a>
                        <button type="submit" class="btn btn-primary" data-busy-label="Saving…">Save name</button>
                    </div>
                </form>
            </div>
        </div>
    }
    else if (testing is { } toTest)
    {
        <div class="modal-backdrop">
            <div class="modal modal-wide" role="dialog" aria-modal="true" aria-labelledby="testorg-title">
                <form method="post" @onsubmit="CreateTestOrganisationAsync" @formname="testorg" data-unsaved-guard>
                    <AntiforgeryToken />
                    <input type="hidden" name="id" value="@toTest.Id" />
                    <div class="modal-body">
                        <h2 id="testorg-title" class="modal-title">Create a test organisation for '@toTest.Name'</h2>
                        <p class="modal-text">We'll create an organisation owned by someone who already has a verified account, and subscribe it to @toTest.Name, so they can sign in and open it straight away.</p>
                        @if (errors.Count > 0)
                        {
                            <AlertBanner Kind="AlertKind.Error" Title="@(errors.Count == 1 ? "Fix 1 problem" : $"Fix {errors.Count} problems")" Class="dialog-alert">
                                <ul>
                                    @foreach (var error in errors)
                                    {
                                        <li>@error</li>
                                    }
                                </ul>
                            </AlertBanner>
                        }

                        <div class="field">
                            <label for="testorg-name">Organisation name</label>
                            <input id="testorg-name" name="name" class="input" value="@enteredOrgName" maxlength="200" autocomplete="off" />
                        </div>
                        <div class="field">
                            <label for="testorg-owner">Owner's email</label>
                            <input id="testorg-owner" name="ownerEmail" type="email" class="input" value="@enteredOwnerEmail" maxlength="254" autocomplete="off" spellcheck="false" />
                            <p class="field-message">They need an account with a verified email. Ask them to sign up first if they don't have one. You can use your own.</p>
                        </div>
                        <div class="field">
                            <label for="testorg-seats">Seats (optional)</label>
                            <input id="testorg-seats" name="seats" class="input" inputmode="numeric" value="@enteredSeats" maxlength="6" autocomplete="off" />
                            <p class="field-message">How many people can have a seat. Leave it empty for no limit. The owner takes the first seat.</p>
                        </div>
                    </div>
                    <div class="modal-foot">
                        <a class="btn btn-secondary" href="/platform/products">Cancel</a>
                        <button type="submit" class="btn btn-primary" data-busy-label="Creating…">Create organisation</button>
                    </div>
                </form>
            </div>
        </div>
    }
    else if (subscribing is { } toSubscribe)
    {
        <div class="modal-backdrop">
            <div class="modal modal-wide" role="dialog" aria-modal="true" aria-labelledby="subscribe-title">
                <form method="post" @onsubmit="SubscribeOrganisationAsync" @formname="subscribe" data-unsaved-guard>
                    <AntiforgeryToken />
                    <input type="hidden" name="id" value="@toSubscribe.Id" />
                    <div class="modal-body">
                        <h2 id="subscribe-title" class="modal-title">Subscribe an organisation to '@toSubscribe.Name'</h2>
                        <p class="modal-text">This brings an existing organisation onto @toSubscribe.Name, or makes a suspended or cancelled subscription active again. The product is told, as it is when it subscribes someone itself.</p>
                        @if (errors.Count > 0)
                        {
                            <AlertBanner Kind="AlertKind.Error" Title="@(errors.Count == 1 ? "Fix 1 problem" : $"Fix {errors.Count} problems")" Class="dialog-alert">
                                <ul>
                                    @foreach (var error in errors)
                                    {
                                        <li>@error</li>
                                    }
                                </ul>
                            </AlertBanner>
                        }

                        <div class="field">
                            <label for="subscribe-org">Organisation id</label>
                            <input id="subscribe-org" name="tenantId" class="input mono" value="@enteredTenantId" maxlength="36" autocomplete="off" spellcheck="false" placeholder="00000000-0000-0000-0000-000000000000" />
                            <p class="field-message">Shown in the organisation's own console, under its profile.</p>
                        </div>
                        <div class="field">
                            <label for="subscribe-seats">Seats (optional)</label>
                            <input id="subscribe-seats" name="seats" class="input" inputmode="numeric" value="@enteredSeats" maxlength="6" autocomplete="off" />
                            <p class="field-message">Leave it empty for no limit. An active subscription keeps the limit it has.</p>
                        </div>
                    </div>
                    <div class="modal-foot">
                        <a class="btn btn-secondary" href="/platform/products">Cancel</a>
                        <button type="submit" class="btn btn-primary" data-busy-label="Subscribing…">Subscribe organisation</button>
                    </div>
                </form>
            </div>
        </div>
    }
    else if (withdrawing is { } toWithdraw)
    {
        <div class="modal-backdrop">
            <div class="modal" role="dialog" aria-modal="true" aria-labelledby="withdraw-title">
                <div class="modal-body">
                    <div class="icon-tile is-error"><Icon Name="alert-triangle" /></div>
                    <h2 id="withdraw-title" class="modal-title">Withdraw '@toWithdraw.Name'?</h2>
                    <p class="modal-text">Nobody will be able to open it, and organisations can't subscribe to it, until you make it available again. Existing subscriptions and seats aren't changed.</p>
                </div>
                <form method="post" action="/platform/products/@toWithdraw.Id/active" class="modal-foot">
                    <AntiforgeryToken />
                    <input type="hidden" name="isActive" value="false" />
                    <a class="btn btn-secondary" href="/platform/products" autofocus>Cancel</a>
                    <button type="submit" class="btn btn-danger" data-busy-label="Withdrawing…">Withdraw product</button>
                </form>
            </div>
        </div>
    }
    else if (rotating is { } toRotate)
    {
        <div class="modal-backdrop">
            <div class="modal modal-wide" role="dialog" aria-modal="true" aria-labelledby="rotate-title">
                <form method="post" action="/platform/products/@toRotate.Id/rotate-secret">
                    <AntiforgeryToken />
                    <div class="modal-body">
                        <h2 id="rotate-title" class="modal-title">Replace the client secret for '@toRotate.Name'?</h2>
                        <p class="modal-text">We'll create a new secret and show it once. The product must be updated to use it. Until the old secret stops, either works, so the product keeps running while its team makes the change.</p>
                        <div class="field">
                            <label for="grace">How long should the old secret keep working?</label>
                            <select id="grace" name="graceHours" class="input">
                                @foreach (var (hours, label) in GraceChoices)
                                {
                                    <option value="@hours" selected="@(hours == 24)">@label</option>
                                }
                            </select>
                            <p class="field-message">Choose "Not at all" if the old secret may have leaked: it stops working at once, and the product stops working until it has the new one.</p>
                        </div>
                    </div>
                    <div class="modal-foot">
                        <a class="btn btn-secondary" href="/platform/products" autofocus>Cancel</a>
                        <button type="submit" class="btn btn-primary" data-busy-label="Replacing…">Replace secret</button>
                    </div>
                </form>
            </div>
        </div>
    }
}

@code {
    private static readonly (int Hours, string Label)[] GraceChoices =
    [
        (0, "Not at all: stop it now"),
        (1, "1 hour"),
        (24, "24 hours (recommended)"),
        (72, "3 days"),
        (168, "7 days"),
        (720, "30 days"),
    ];

    private bool leaving;
    private bool ready;
    private bool loadFailed;
    private bool registering;
    private string? reference;
    private string? revealed;
    private string enteredName = "";
    private string enteredKey = "";
    private string enteredAudience = "";
    private string enteredUrl = "";
    private string enteredLaunchUrl = "";
    private string enteredPermissions = "";
    private string enteredNewName = "";
    private bool activateChecked = true;
    private string enteredOrgName = "";
    private string enteredOwnerEmail = "";
    private string enteredSeats = "";
    private string enteredTenantId = "";
    private AdminProductItem? testing;
    private AdminProductItem? subscribing;
    private AdminProductItem? renaming;
    private AdminProductItem? rotating;
    private AdminProductItem? withdrawing;
    private AdminProductItem? launching;
    private readonly List<string> errors = [];
    private List<AdminProductItem> products = [];

    [CascadingParameter] private HttpContext? HttpContext { get; set; }

    [SupplyParameterFromQuery(Name = "register")] private string? Register { get; set; }

    [SupplyParameterFromQuery(Name = "rotate")] private Guid? RotateId { get; set; }

    [SupplyParameterFromQuery(Name = "withdraw")] private Guid? WithdrawId { get; set; }

    [SupplyParameterFromQuery(Name = "launch")] private Guid? LaunchId { get; set; }

    [SupplyParameterFromQuery(Name = "rename")] private Guid? RenameId { get; set; }

    [SupplyParameterFromQuery(Name = "testorg")] private Guid? TestOrgId { get; set; }

    [SupplyParameterFromQuery(Name = "subscribe")] private Guid? SubscribeId { get; set; }

    // What an admin just did with an organisation, carried in the address after it (an id and a name, nothing secret).
    [SupplyParameterFromQuery(Name = "org")] private string? OrgName { get; set; }

    [SupplyParameterFromQuery(Name = "owner")] private string? OwnerEmail { get; set; }

    [SupplyParameterFromQuery(Name = "tid")] private string? OrgId { get; set; }

    // What a registration did, carried in the address after it (none of it is secret): the audience, whether it went live, where it
    // opens and how many permissions were saved with it.
    [SupplyParameterFromQuery(Name = "aud")] private string? Audience { get; set; }

    [SupplyParameterFromQuery(Name = "live")] private string? Live { get; set; }

    [SupplyParameterFromQuery(Name = "opens")] private string? OpensAt { get; set; }

    [SupplyParameterFromQuery(Name = "perms")] private int? Permissions { get; set; }

    private int PermissionTotal => Math.Max(0, Permissions ?? 0);

    [SupplyParameterFromQuery(Name = "reveal")] private string? Reveal { get; set; }

    [SupplyParameterFromQuery(Name = "registered")] private string? Registered { get; set; }

    [SupplyParameterFromQuery(Name = "name")] private string? RegisteredName { get; set; }

    [SupplyParameterFromQuery(Name = "client")] private string? ClientId { get; set; }

    [SupplyParameterFromQuery(Name = "oldEnds")] private string? OldEnds { get; set; }

    [SupplyParameterFromQuery(Name = "app")] private Guid? AppId { get; set; }

    [SupplyParameterFromQuery(Name = "notice")] private string? NoticeCode { get; set; }

    [SupplyParameterFromQuery(Name = "error")] private string? ErrorCode { get; set; }

    private string OldSecretTitle => OldEnds == "now" ? "The old secret stopped working at once" : "The old secret keeps working for a while";

    private string OldSecretBody =>
        OldEnds == "now"
            ? "You chose to cut it off, so the product can't prove who it is until it has the new secret. Give it the new secret now."
            : DateTimeOffset.TryParse(OldEnds, CultureInfo.InvariantCulture, DateTimeStyles.AssumeUniversal, out var ends)
                ? $"It stops working at {ends.UtcDateTime:d MMM yyyy, HH:mm} UTC, in {Remaining(ends - Time.GetUtcNow())}. The product needs the new secret before then."
                : "The product needs the new secret before the old one stops.";

    private static string Remaining(TimeSpan left) =>
        left.TotalHours >= 48 ? $"{(int)left.TotalDays} days"
        : left.TotalHours >= 1 ? $"{(int)left.TotalHours} {((int)left.TotalHours == 1 ? "hour" : "hours")}"
        : $"{Math.Max(1, (int)left.TotalMinutes)} minutes";

    private RenderFragment? Notice() => builder =>
    {
        var name = products.FirstOrDefault(product => product.Id == AppId)?.Name ?? "This product";
        switch (NoticeCode, ErrorCode)
        {
            case ("available", _):
                Banner(builder, AlertKind.Success, $"{name} is available", "Organisations can subscribe to it and people with a seat can open it.");
                break;
            case ("withdrawn", _):
                Banner(builder, AlertKind.Success, $"{name} is withdrawn", "Nobody can open it and organisations can't subscribe until it is made available again.");
                break;
            case ("testorg", _):
                Banner(builder, AlertKind.Success, $"{OrgName ?? "The organisation"} is ready", $"{OwnerEmail ?? "Its owner"} owns it and can open {name} in it. Organisation id: {OrgId}");
                break;
            case ("subscribed", _):
                Banner(builder, AlertKind.Success, $"The organisation is subscribed to {name}", $"Organisation id: {OrgId}. Its owners have a seat and anyone it gives a seat to can open {name}.");
                break;
            case ("renamed", _):
                Banner(builder, AlertKind.Success, $"{name} is renamed", "Its key and token audience are unchanged, so the product keeps working.");
                break;
            case ("launch_saved", _):
                Banner(builder, AlertKind.Success, $"{name}'s address is saved", "People who choose it in the picker are sent there.");
                break;
            case ("launch_cleared", _):
                Banner(builder, AlertKind.Success, $"{name}'s address is cleared", "People can't open it from the picker until an address is set.");
                break;
            case (_, "no_permissions_registered"):
                Banner(builder, AlertKind.Warning, $"{name} has no permissions yet", "A product needs at least one permission before it can be made available.");
                break;
            case (_, "application_not_found"):
                Banner(builder, AlertKind.Warning, "That product isn't here any more", "The list is up to date.");
                break;
            case (_, "bad_grace"):
                Banner(builder, AlertKind.Warning, "Choose how long the old secret keeps working", "Pick one of the options, from not at all up to 30 days.");
                break;
            case (_, "forbidden"):
                Banner(builder, AlertKind.Error, "You don't have permission to do that", "Only platform admins can change products.");
                break;
            case (_, "unavailable"):
                Banner(builder, AlertKind.Error, $"We couldn't change {name}", "Auth Service isn't responding right now. Nothing was changed. Try again in a moment.");
                break;
        }
    };

    private static void Banner(Microsoft.AspNetCore.Components.Rendering.RenderTreeBuilder builder, AlertKind kind, string title, string body)
    {
        builder.OpenComponent<AlertBanner>(0);
        builder.AddAttribute(1, nameof(AlertBanner.Kind), kind);
        builder.AddAttribute(2, nameof(AlertBanner.Title), title);
        builder.AddAttribute(3, nameof(AlertBanner.Class), "auth-alert");
        builder.AddAttribute(4, nameof(AlertBanner.ChildContent), (RenderFragment)(inner => inner.AddMarkupContent(0, $"<p class=\"alert-body\">{System.Net.WebUtility.HtmlEncode(body)}</p>")));
        builder.CloseComponent();
    }

    protected override async Task OnInitializedAsync()
    {
        try
        {
            await LoadAsync();
        }
        finally
        {
            ready = true;
        }
    }

    private bool Posted(string handler) =>
        HttpContext is { } context && context.Request.HasFormContentType && context.Request.Form["_handler"] == handler;

    private async Task LoadAsync()
    {
        if (HttpContext is null)
        {
            return;
        }

        // The layout has already asked the API; this is the same answer.
        var access = await Platform.LoadAsync(HttpContext);
        if (access.Outcome != PlatformOutcome.Allowed)
        {
            return;
        }

        var list = await Api.GetAllAsync<AdminProductItem>("/api/auth/admin/applications", access.Token!, HttpContext.RequestAborted);
        if (!list.IsSuccess)
        {
            if (list.Problem!.Status == StatusCodes.Status401Unauthorized)
            {
                leaving = true;
                Navigation.NavigateTo("/login?returnUrl=%2Fplatform%2Fproducts&reason=expired");
                return;
            }

            loadFailed = true;
            reference = HttpContext.TraceIdentifier.Length >= 8 ? HttpContext.TraceIdentifier[^8..].ToLowerInvariant() : null;
            return;
        }

        products = [.. list.Value!.OrderBy(product => product.Name, StringComparer.OrdinalIgnoreCase)];

        // A new secret is taken back out exactly once: a reload of this page finds nothing.
        if (Reveal is { Length: > 0 } token && HttpContext.User.FindFirst(SessionAuthentication.SessionIdClaim) is { } sid)
        {
            revealed = Secrets.Take(sid.Value, token);
        }

        if (revealed is not null)
        {
            return;
        }

        // A posted form must already be on the page when the post arrives.
        registering = Register == "1" || Posted("register");
        if (Register != "1" && Posted("launch") && Guid.TryParse(HttpContext.Request.Form["id"].ToString(), out var posted))
        {
            launching = products.FirstOrDefault(product => product.Id == posted);
        }
        else if (LaunchId is { } launchId)
        {
            launching = products.FirstOrDefault(product => product.Id == launchId);
            enteredUrl = launching?.LaunchUrl ?? "";
        }

        if (!registering && launching is null)
        {
            if (Posted("rename") && Guid.TryParse(HttpContext.Request.Form["id"].ToString(), out var postedRename))
            {
                renaming = products.FirstOrDefault(product => product.Id == postedRename);
            }
            else if (RenameId is { } renameId)
            {
                renaming = products.FirstOrDefault(product => product.Id == renameId);
                enteredNewName = renaming?.Name ?? "";
            }
        }

        if (!registering && launching is null && renaming is null)
        {
            if (Posted("testorg") && Guid.TryParse(HttpContext.Request.Form["id"].ToString(), out var postedTest))
            {
                testing = products.FirstOrDefault(product => product.Id == postedTest && product.IsActive);
            }
            else if (TestOrgId is { } testId)
            {
                testing = products.FirstOrDefault(product => product.Id == testId && product.IsActive);
                enteredOrgName = testing is null ? "" : $"{testing.Name} test";
            }

            if (testing is null && Posted("subscribe") && Guid.TryParse(HttpContext.Request.Form["id"].ToString(), out var postedSubscribe))
            {
                subscribing = products.FirstOrDefault(product => product.Id == postedSubscribe && product.IsActive);
            }
            else if (testing is null && SubscribeId is { } subscribeId)
            {
                subscribing = products.FirstOrDefault(product => product.Id == subscribeId && product.IsActive);
            }
        }

        if (!registering && launching is null && renaming is null && testing is null && subscribing is null)
        {
            withdrawing = WithdrawId is { } withdrawId ? products.FirstOrDefault(product => product.Id == withdrawId && product.IsActive) : null;
            rotating = withdrawing is null && RotateId is { } id ? products.FirstOrDefault(product => product.Id == id) : null;
        }
    }

    private async Task RegisterAsync()
    {
        var form = HttpContext!.Request.Form;
        enteredName = form["name"].ToString().Trim();
        enteredKey = form["key"].ToString().Trim();
        enteredAudience = form["audience"].ToString().Trim();
        enteredLaunchUrl = form["launchUrl"].ToString().Trim();
        enteredPermissions = form["permissions"].ToString();
        activateChecked = form.ContainsKey("activate");

        errors.Clear();
        if (enteredName.Length == 0)
        {
            errors.Add("Enter a name for the product.");
        }

        if (enteredKey.Length == 0)
        {
            errors.Add("Enter a key for the product.");
        }

        // Left empty, the audience follows the key ("helpdesk" gives "helpdesk-api"); with no key either there is nothing to follow.
        if (enteredAudience.Length == 0 && enteredKey.Length == 0)
        {
            errors.Add("Enter the token audience for the product.");
        }

        var (permissions, permissionErrors) = PermissionText.Parse(enteredPermissions);
        errors.AddRange(permissionErrors.Take(5));

        if (errors.Count > 0)
        {
            return;
        }

        // The product goes live in the same step only when it has permissions to make it available with.
        var request = new RegisterProductRequest(
            enteredKey,
            enteredName,
            enteredAudience.Length == 0 ? $"{enteredKey}-api" : enteredAudience,
            enteredLaunchUrl.Length == 0 ? null : enteredLaunchUrl,
            permissions.Count == 0 ? null : permissions,
            activateChecked && permissions.Count > 0 ? true : null);

        var access = await Platform.LoadAsync(HttpContext);
        var result = await Api.PostAsync<RegisterProductRequest, RegisteredProduct>(
            "/api/auth/admin/applications", request, HttpContext.RequestAborted, access.Token);
        if (result.IsSuccess && HttpContext.User.FindFirst(SessionAuthentication.SessionIdClaim) is { } sid)
        {
            // The secret waits on the server; the address carries only a reference and what is not secret: the product's name, its audience,
            // its (public) client id, where it opens, how many permissions it has and whether it is available.
            var product = result.Value!;
            var reference_ = Secrets.Put(sid.Value, product.ClientSecret);
            leaving = true;
            var opens = product.LaunchUrl is { Length: > 0 } address ? $"&opens={Uri.EscapeDataString(address)}" : "";
            Navigation.NavigateTo($"/platform/products?reveal={reference_}&registered=1&app={product.Id}&name={Uri.EscapeDataString(product.Name)}&client={Uri.EscapeDataString(product.ClientId)}&aud={Uri.EscapeDataString(product.JwtAudience)}&perms={product.PermissionCount}&live={(product.IsActive ? 1 : 0)}{opens}");
            return;
        }

        var problem = result.Problem;
        if (problem?.Status == StatusCodes.Status401Unauthorized)
        {
            leaving = true;
            Navigation.NavigateTo("/login?returnUrl=%2Fplatform%2Fproducts&reason=expired");
            return;
        }

        if (problem?.Code == "application_key_taken")
        {
            errors.Add("A product with this key already exists. Choose another key.");
        }
        else if (problem?.Code == "audience_taken")
        {
            errors.Add("Another product already uses this token audience. Choose another.");
        }
        else if (problem?.Status == StatusCodes.Status400BadRequest && problem.Errors is { Count: > 0 } apiErrors)
        {
            foreach (var reason in apiErrors.Values.SelectMany(reasons => reasons).Take(5))
            {
                errors.Add(reason);
            }
        }
        else
        {
            errors.Add(problem?.Status == StatusCodes.Status403Forbidden
                ? "You don't have permission to register products."
                : "Auth Service isn't responding right now. Nothing was registered. Try again in a moment.");
        }
    }

    private async Task RenameAsync()
    {
        enteredNewName = HttpContext!.Request.Form["name"].ToString().Trim();
        errors.Clear();
        if (renaming is null)
        {
            return;
        }

        if (enteredNewName.Length == 0)
        {
            errors.Add("Enter a name for the product.");
            return;
        }

        var access = await Platform.LoadAsync(HttpContext);
        var result = await Api.PutNoContentAsync(
            $"/api/auth/admin/applications/{renaming.Id}/name", new RenameProductRequest(enteredNewName), access.Token!, HttpContext.RequestAborted);
        if (result.IsSuccess)
        {
            leaving = true;
            Navigation.NavigateTo($"/platform/products?notice=renamed&app={renaming.Id}");
            return;
        }

        var problem = result.Problem;
        if (problem?.Status == StatusCodes.Status401Unauthorized)
        {
            leaving = true;
            Navigation.NavigateTo("/login?returnUrl=%2Fplatform%2Fproducts&reason=expired");
            return;
        }

        if (problem?.Status == StatusCodes.Status400BadRequest && problem.Errors is { Count: > 0 } apiErrors)
        {
            foreach (var reason in apiErrors.Values.SelectMany(reasons => reasons).Take(3))
            {
                errors.Add(reason);
            }
        }
        else
        {
            errors.Add(problem?.Status == StatusCodes.Status403Forbidden
                ? "You don't have permission to change products."
                : problem?.Code == "application_not_found"
                    ? "That product isn't here any more."
                    : "Auth Service isn't responding right now. Nothing was changed. Try again in a moment.");
        }
    }

    // Seats are optional: empty means no limit, otherwise a whole number of at least 1.
    private bool TryReadSeats(out int? seats)
    {
        seats = null;
        enteredSeats = HttpContext!.Request.Form["seats"].ToString().Trim();
        if (enteredSeats.Length == 0)
        {
            return true;
        }

        if (int.TryParse(enteredSeats, NumberStyles.None, CultureInfo.InvariantCulture, out var count) && count >= 1)
        {
            seats = count;
            return true;
        }

        errors.Add("Seats must be a whole number of at least 1, or left empty for no limit.");
        return false;
    }

    private async Task CreateTestOrganisationAsync()
    {
        var form = HttpContext!.Request.Form;
        enteredOrgName = form["name"].ToString().Trim();
        enteredOwnerEmail = form["ownerEmail"].ToString().Trim();
        errors.Clear();
        if (testing is null)
        {
            return;
        }

        if (enteredOrgName.Length == 0)
        {
            errors.Add("Enter a name for the organisation.");
        }

        if (enteredOwnerEmail.Length == 0)
        {
            errors.Add("Enter the owner's email.");
        }

        TryReadSeats(out var seats);
        if (errors.Count > 0)
        {
            return;
        }

        var access = await Platform.LoadAsync(HttpContext);
        var result = await Api.PostAsync<CreateTestOrganisationRequest, TestOrganisationCreated>(
            $"/api/auth/admin/applications/{testing.Id}/test-organisations",
            new CreateTestOrganisationRequest(enteredOrgName, enteredOwnerEmail, seats),
            HttpContext.RequestAborted,
            access.Token);
        if (result.IsSuccess)
        {
            var created = result.Value!;
            leaving = true;
            Navigation.NavigateTo($"/platform/products?notice=testorg&app={testing.Id}&org={Uri.EscapeDataString(created.TenantName)}&owner={Uri.EscapeDataString(created.OwnerEmail)}&tid={created.TenantId}");
            return;
        }

        ExplainOrganisationProblem(result.Problem, "Nothing was created.");
    }

    private async Task SubscribeOrganisationAsync()
    {
        enteredTenantId = HttpContext!.Request.Form["tenantId"].ToString().Trim();
        errors.Clear();
        if (subscribing is null)
        {
            return;
        }

        if (!Guid.TryParse(enteredTenantId, out var tenantId) || tenantId == Guid.Empty)
        {
            errors.Add("Enter the organisation's id, the long code with dashes.");
        }

        TryReadSeats(out var seats);
        if (errors.Count > 0)
        {
            return;
        }

        var access = await Platform.LoadAsync(HttpContext);
        var result = await Api.PostAsync<SubscribeOrganisationRequest, AdminSubscription>(
            $"/api/auth/admin/applications/{subscribing.Id}/subscriptions",
            new SubscribeOrganisationRequest(tenantId, seats),
            HttpContext.RequestAborted,
            access.Token);
        if (result.IsSuccess)
        {
            leaving = true;
            Navigation.NavigateTo($"/platform/products?notice=subscribed&app={subscribing.Id}&tid={tenantId}");
            return;
        }

        ExplainOrganisationProblem(result.Problem, "Nothing was changed.");
    }

    // The API's reasons for refusing an organisation to be created or subscribed, in plain words.
    private void ExplainOrganisationProblem(ApiProblem? problem, string nothingDone)
    {
        if (problem?.Status == StatusCodes.Status401Unauthorized)
        {
            leaving = true;
            Navigation.NavigateTo("/login?returnUrl=%2Fplatform%2Fproducts&reason=expired");
            return;
        }

        switch (problem?.Code)
        {
            case "owner_not_found":
                errors.Add("No account has that email. Ask them to sign up first, then try again.");
                return;
            case "owner_email_not_verified":
                errors.Add("They haven't verified their email yet, so they can't sign in. Ask them to open the link we emailed them, then try again.");
                return;
            case "owner_disabled":
                errors.Add("That person's access has been removed, so they can't own a new organisation.");
                return;
            case "tenant_not_found":
                errors.Add("No organisation has that id. Check it and try again.");
                return;
            case "tenant_suspended":
                errors.Add("That organisation is suspended, so it can't subscribe to anything.");
                return;
            case "application_not_active":
                errors.Add("This product isn't available any more. Make it available first.");
                return;
            case "application_not_found":
                errors.Add("That product isn't here any more.");
                return;
        }

        if (problem?.Status == StatusCodes.Status400BadRequest && problem.Errors is { Count: > 0 } apiErrors)
        {
            foreach (var reason in apiErrors.Values.SelectMany(reasons => reasons).Take(3))
            {
                errors.Add(reason);
            }

            return;
        }

        errors.Add(problem?.Status == StatusCodes.Status403Forbidden
            ? "You don't have permission to do that."
            : $"Auth Service isn't responding right now. {nothingDone} Try again in a moment.");
    }

    private async Task SaveLaunchAsync()
