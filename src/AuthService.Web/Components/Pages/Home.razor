@page "/"
@inject NavigationManager Navigation

<PageTitle>Auth Service</PageTitle>

<h1>Auth Service</h1>

<p>The web console is being built. The tenant console and the platform console arrive with the design (see the Web UI epic).</p>

<p><a href="/login">Sign in</a></p>

@code {
    [CascadingParameter] private HttpContext? HttpContext { get; set; }

    protected override void OnInitialized()
    {
        // Someone signed in has no use for this page: they go on to choose an organisation.
        if (HttpContext?.User.Identity?.IsAuthenticated == true)
        {
            Navigation.NavigateTo("/choose-organisation");
        }
    }
}
