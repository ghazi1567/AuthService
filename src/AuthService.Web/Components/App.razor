<!DOCTYPE html>
<html lang="en">

<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <base href="/" />
    <ResourcePreloader />
    <link rel="stylesheet" href="@Assets["app.css"]" />
    <link rel="stylesheet" href="@Assets["AuthService.Web.styles.css"]" />
    @* The import map is the one inline script on every page, so it carries the request's nonce (AUTH-271). *@
    <ImportMap nonce="@Nonce" />
    <HeadOutlet />
</head>

<body>
    <Routes />
    <ReconnectModal />
    <script src="@Assets["_framework/blazor.web.js"]"></script>
    <script src="@Assets["app.js"]"></script>
</body>

</html>

@code {
    [CascadingParameter] private HttpContext? HttpContext { get; set; }

    private string? Nonce => HttpContext is null ? null : AuthService.Web.Security.SecurityHeaders.Nonce(HttpContext);
}
