<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <!-- The package a product API installs to enforce Auth Service tokens (TOK-03). Version it like any library: a breaking change
         to the claim contract or the public API is a new major version. -->
    <PackageId>AuthService.Authorization</PackageId>
    <IsPackable>true</IsPackable>
    <Description>Validates Auth Service product tokens locally against the published JWKS, checks the audience, exposes the tenant, and enforces permissions by level.</Description>
    <GenerateDocumentationFile>true</GenerateDocumentationFile>
  </PropertyGroup>

  <PropertyGroup Label="Version">
    <!-- The version of a released package is the tag that CI was triggered by (authorization-v1.2.3 gives 1.2.3), passed in as
         -p:Version. A build from anywhere else is not a release and says so. -->
    <Version Condition="'$(Version)' == ''">0.0.0-local</Version>
  </PropertyGroup>

  <PropertyGroup Label="Package contents">
    <Authors>Auth Service</Authors>
    <PackageTags>authentication;authorization;jwt;jwks;multi-tenant;aspnetcore</PackageTags>
    <PackageReadmeFile>README.md</PackageReadmeFile>
    <!-- Published publicly on nuget.org under MIT. No project or repository URL on purpose: the repository is private, so a link would
         lead nowhere for everyone who installs the package. -->
    <PackageLicenseExpression>MIT</PackageLicenseExpression>
  </PropertyGroup>

  <PropertyGroup Label="Symbols">
    <!-- The debug symbols travel inside the package, so no second symbol package is needed. The source files are not embedded and no
         source link is published, because the repository is private. -->
    <DebugType>embedded</DebugType>
  </PropertyGroup>

  <PropertyGroup Condition="'$(GITHUB_ACTIONS)' == 'true'">
    <!-- Paths in the symbols are rewritten so they do not depend on the machine that built them. -->
    <ContinuousIntegrationBuild>true</ContinuousIntegrationBuild>
  </PropertyGroup>

  <ItemGroup>
    <FrameworkReference Include="Microsoft.AspNetCore.App" />
  </ItemGroup>

  <ItemGroup>
    <PackageReference Include="Microsoft.AspNetCore.Authentication.JwtBearer" />
  </ItemGroup>

  <ItemGroup>
    <None Include="README.md" Pack="true" PackagePath="\" />
  </ItemGroup>

</Project>
